PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/hvk

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_REGISTRATION_FEE=50000
# amount in paise, e.g. 50000 = ₹500.00

# Secret from the Razorpay dashboard webhook config (Settings > Webhooks), NOT the
# same as RAZORPAY_KEY_SECRET. Point the webhook at POST /api/razorpay/webhook and
# subscribe to "payment.captured" at minimum. Confirms payment even if the client
# never calls /api/razorpay/verify.
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# Brevo
BREVO_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_FROM_EMAIL=registrations@yourdomain.com
BREVO_FROM_NAME=HVK Registrations

# Comma-separated list of allowed origins (web app domain, mobile app scheme/dev URL).
# Use * only for local development.
CORS_ORIGINS=http://localhost:3000,https://hvk-app.vercel.app

# Public web app origin. Used to build the Razorpay Payment Link's callback_url —
# Razorpay redirects the browser to ${FRONTEND_URL}/registration/callback after checkout.
FRONTEND_URL=http://localhost:3000

# hvk-exam-backend integration
EXAM_API_URL=http://localhost:5100
INTERNAL_EXAM_API_KEY=change-me-to-a-long-random-string

# Shared secret required in the x-admin-api-key header for internal/admin-only routes
# (currently just POST /api/candidates/:id/resend-exam-link).
ADMIN_API_KEY=change-me-to-a-long-random-string
