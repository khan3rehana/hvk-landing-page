{
  "name": "hvk-backend",
  "version": "1.0.0",
  "description": "HVK backend API - candidate registration, Razorpay payments, Brevo email. Shared by web and mobile.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/templates', 'dist/templates', { recursive: true, force: true })\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "license": "ISC",
  "dependencies": {
    "@getbrevo/brevo": "^6.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "razorpay": "^2.9.8",
    "sib-api-v3-sdk": "^8.5.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
